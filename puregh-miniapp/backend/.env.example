PORT=3001
# Postgres (same DB the n8n workflows use). From the host 127.0.0.1:5433,
# from inside the VM network puregh-db:5432.
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=puregh
PGUSER=puregh
PGPASSWORD=
# Telegram bot that owns the Mini App (the review buttons now point here).
TELEGRAM_BOT_TOKEN=
# Owner Telegram chat id — the only account allowed to review.
OWNER_CHAT=5622960785
# Base URL of the Mini App, used to build the inline "open app" button.
# e.g. https://puregh-app.style.dev or a cloudflared tunnel URL during testing.
MINIAPP_URL=
# OpenAI-compatible LLM used for caption regeneration + add-repo captions.
# Same provider/fallback model pair as the n8n workflow.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
# GitHub personal access token (public_repo scope) for repo metadata + README.
GITHUB_TOKEN=